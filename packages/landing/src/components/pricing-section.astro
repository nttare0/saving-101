---
const CHECK =
  '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-chart-positive mt-0.5 size-4 shrink-0"><path d="M20 6 9 17l-5-5"/></svg>';

const plans = [
  {
    name: 'Essential',
    tagline: 'Manual entry and everything that is local math.',
    yearly: 30,
    monthly: 5,
    features: [
      'Imports: CSV, OFX, YNAB, Wallet, MS Money',
      'Investments, loans, vehicles, venture',
      'AI features with your own API key',
      'Backup export and restore',
      'MCP server for AI agents',
      '2 household seats',
    ],
  },
  {
    name: 'Plus',
    tagline: 'Everything around bring-your-own bank connections.',
    yearly: 55,
    monthly: 8,
    highlight: true,
    features: [
      'Everything in Essential',
      'Bank sync: LunchFlow, SimpleFIN, Monobank, Akahu',
      'AI features on our key, no setup',
      'FIRE planner',
      '5 household seats',
    ],
  },
  {
    name: 'Premium',
    tagline: 'Bank connections we run for you.',
    planned: true,
    yearly: 80,
    monthly: 12,
    features: [
      'Everything in Plus',
      'Bank sync we run: no API keys, no provider subscription',
      '2 banks included (unlimited accounts), extra banks $2/mo',
      'Real-time security prices',
      'Higher AI usage cap',
      '10 household seats',
    ],
  },
];
---

<section id="pricing" class="relative z-10 py-16 sm:py-24">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Simple pricing</h2>
      <p class="text-muted-foreground mt-4 text-lg">
        40-day free trial of every cloud feature, no card needed. Self-hosting is free, forever.
      </p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-3">
      {
        plans.map((plan) => (
          <div
            class:list={[
              'border-border bg-card relative flex flex-col rounded-xl border p-6',
              plan.highlight && 'border-foreground/30',
            ]}
          >
            {plan.highlight && (
              <span class="bg-primary text-primary-foreground absolute -top-3 left-6 rounded-full px-2.5 py-0.5 text-xs font-medium">
                Most popular
              </span>
            )}
            {plan.planned && (
              <span class="border-border text-muted-foreground bg-background absolute -top-3 left-6 rounded-full border px-2.5 py-0.5 text-xs font-medium">
                Planned
              </span>
            )}
            <h3 class="text-lg font-semibold">{plan.name}</h3>
            <p class="text-muted-foreground mt-1 text-sm">{plan.tagline}</p>
            <div class="mt-6">
              <span class="text-4xl font-semibold tracking-tight tabular-nums">${plan.yearly}</span>
              <span class="text-muted-foreground">/year</span>
              <span class="bg-chart-positive/10 text-chart-positive ml-2 rounded-md px-1.5 py-0.5 align-middle text-xs font-medium">
                Save ${plan.monthly * 12 - plan.yearly}/yr
              </span>
              <span class="text-muted-foreground block text-sm">or ${plan.monthly}/month</span>
            </div>
            <ul class="mt-6 space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm">
                  <Fragment set:html={CHECK} />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-8">
              {plan.planned ? (
                <button
                  type="button"
                  id="premium-early-access"
                  class="border-input bg-input/30 hover:bg-input/50 flex h-10 w-full cursor-pointer items-center justify-center rounded-md border px-6 text-sm font-medium shadow-xs transition-colors"
                >
                  Get early access
                </button>
              ) : (
                <a
                  href="/sign-up"
                  class:list={[
                    'flex h-10 w-full items-center justify-center rounded-md px-6 text-sm font-medium shadow-xs transition-colors',
                    plan.highlight
                      ? 'bg-primary text-primary-foreground hover:bg-primary/90'
                      : 'border-input bg-input/30 hover:bg-input/50 border',
                  ]}
                  data-track="landing_cta_clicked"
                  data-track-location="pricing"
                >
                  Start free trial
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-8 text-center text-sm">
      Prices in USD. Taxes are calculated at checkout. Cancel anytime.
    </p>
  </div>

  <dialog
    id="premium-early-access-dialog"
    aria-labelledby="premium-early-access-title"
    closedby="any"
    class="border-border bg-card text-foreground relative m-auto w-[calc(100%-2rem)] max-w-md rounded-xl border p-6 backdrop:bg-black/60"
  >
    <form method="dialog">
      <button
        aria-label="Close"
        class="text-muted-foreground hover:text-foreground absolute top-4 right-4 cursor-pointer text-xl leading-none"
      >
        &times;
      </button>
    </form>
    <form id="premium-early-access-form">
      <h3 id="premium-early-access-title" class="text-lg font-semibold">Premium is coming</h3>
      <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
        We'll open Premium once enough people want it. Leave your email and we'll let you know when it's available, or
        just count your vote.
      </p>
      <input
        name="email"
        type="email"
        required
        aria-label="Email"
        autocomplete="email"
        placeholder="you@example.com"
        class="border-input bg-input/30 placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/50 mt-5 h-10 w-full rounded-md border px-3 text-sm shadow-xs outline-none focus-visible:ring-[3px]"
      />
      <div class="mt-5 flex flex-col gap-2 sm:flex-row-reverse">
        <button
          type="submit"
          value="email"
          class="bg-primary text-primary-foreground hover:bg-primary/90 h-10 flex-1 cursor-pointer rounded-md px-4 text-sm font-medium shadow-xs transition-colors"
        >
          Notify me
        </button>
        <button
          type="submit"
          value="vote"
          formnovalidate
          class="border-input bg-input/30 hover:bg-input/50 h-10 flex-1 cursor-pointer rounded-md border px-4 text-sm font-medium shadow-xs transition-colors"
        >
          Just count my vote
        </button>
      </div>
    </form>
    <div id="premium-early-access-thanks" hidden>
      <h3 class="text-lg font-semibold">Thanks, your vote is counted</h3>
      <p id="premium-early-access-thanks-email" class="text-muted-foreground mt-2 text-sm" hidden>
        We'll email you when Premium opens.
      </p>
      <form method="dialog" class="mt-5">
        <button
          class="border-input bg-input/30 hover:bg-input/50 h-10 w-full cursor-pointer rounded-md border px-4 text-sm font-medium shadow-xs transition-colors"
        >
          Close
        </button>
      </form>
    </div>
  </dialog>
</section>

<script>
  import { trackAnalyticsEvent } from '@/lib/posthog';

  const VOTED_KEY = 'premium-early-access';

  const dialog = document.getElementById('premium-early-access-dialog') as HTMLDialogElement;
  const form = document.getElementById('premium-early-access-form') as HTMLFormElement;
  const thanks = document.getElementById('premium-early-access-thanks')!;
  const thanksEmail = document.getElementById('premium-early-access-thanks-email')!;

  const showThanks = ({ withEmail }: { withEmail: boolean }) => {
    form.hidden = true;
    thanks.hidden = false;
    thanksEmail.hidden = !withEmail;
  };

  document.getElementById('premium-early-access')?.addEventListener('click', () => {
    trackAnalyticsEvent({ event: 'landing_premium_early_access_clicked', properties: { location: 'pricing' } });
    dialog.showModal();
  });

  // Storage throws when the browser blocks it; the dialog must keep working without it.
  try {
    const saved = localStorage.getItem(VOTED_KEY);
    if (saved) showThanks({ withEmail: saved === 'email' });
  } catch {}

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const withEmail = (event.submitter as HTMLButtonElement | null)?.value === 'email';
    const sent = trackAnalyticsEvent({
      event: 'landing_premium_early_access_submitted',
      properties: withEmail
        ? { with_email: true, email: String(new FormData(form).get('email')).trim() }
        : { with_email: false },
    });

    // Only promise an email that actually reached PostHog.
    showThanks({ withEmail: withEmail && sent });
    try {
      localStorage.setItem(VOTED_KEY, withEmail && sent ? 'email' : 'vote');
    } catch {}
  });
</script>
