---
import FaqAsk from '@/components/faq-ask.vue';
import FaqDetails from '@/components/faq-details.astro';
import { FAQ_ITEMS } from '@/lib/faq';
---

<section id="faq" class="relative z-10 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Questions, answered</h2>
      <p class="text-muted-foreground mt-4 text-lg">
        Ask anything else below, or at{' '}
        <a href="mailto:support@moneymatter.app" class="text-foreground font-medium underline underline-offset-4">support@moneymatter.app</a>.
      </p>
    </div>

    <div class="mt-12 space-y-2">
      <FaqDetails items={FAQ_ITEMS} />
      <FaqAsk client:visible />
    </div>
  </div>
</section>
